# dependencies
/node_modules
dev.db
/dev.db
/prisma/dev.db
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/test-results/
/e2e-audit/
/playwright-report/
/blob-report/
