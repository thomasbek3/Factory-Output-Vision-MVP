{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-vision-station-calibration.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "station_id",
    "created_at",
    "source_artifacts",
    "confidence_notes",
    "source_polygons",
    "output_polygons",
    "ignore_polygons",
    "refuses_validation_truth",
    "activation_status"
  ],
  "properties": {
    "schema_version": { "const": "factory-vision-station-calibration-v1" },
    "station_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "source_artifacts": { "type": "object" },
    "confidence_notes": { "type": "object" },
    "source_polygons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/polygon" }
    },
    "output_polygons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/polygon" }
    },
    "ignore_polygons": {
      "type": "array",
      "items": { "$ref": "#/$defs/polygon" }
    },
    "gate": {
      "type": "object",
      "required": ["start", "end", "source_side"],
      "properties": {
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "source_side": { "type": "integer", "enum": [-1, 1] }
      }
    },
    "refuses_validation_truth": { "const": true },
    "activation_status": {
      "type": "string",
      "enum": ["candidate", "ready_for_replay", "ready_for_live", "live"]
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" }
    }
  }
}
